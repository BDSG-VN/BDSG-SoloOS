# Generate three different secrets; never give OWNER_TOKEN or STORE_KEY to an LLM.
BDSG_OWNER_TOKEN=
BDSG_AGENT_TOKEN=
BDSG_STORE_KEY=
BDSG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
BDSG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
BDSG_SECURE_COOKIES=false
BDSG_LLM_BASE_URL=
BDSG_LLM_API_KEY=
BDSG_LLM_MODEL=solo-default
